.env
.env.*
docker-compose.override.yml

# Databases and local storage
*.sqlite
*.db
*.sqlite3

# Keys and certificates
*.pem
*.key
id_rsa*
id_*

# IDE/editor directories
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

